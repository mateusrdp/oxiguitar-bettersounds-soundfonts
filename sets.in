# The sound sets, one per line. scripts/pin.sh turns this into sets.txt (every
# file, with its address and SHA-256). Fields, separated by |:
#
#   id | name | role | licence | credit | GitHub repository | ref | the
#   instrument's .sfz in it | what to call it once installed | notice
#
# One instrument per set, no variations: only the one .sfz named here is
# kept (renamed, nothing inside it is changed), with the files it plays and
# the licence and readme. Every set is credited, whatever its licence. The
# notice is text a licence asks to be shown (empty when none).
#
# role is one of electric-guitars, acoustic-guitars, basses, drums.
clean-guitar|FreePats|electric-guitars|CC0 1.0|FreePats (Electric Guitar FSBS, clean)|freepats/electric-guitar-FSBS-clean|HEAD|EGuitarFSBS-clean bridge 20260807.sfz|Clean Guitar|
overdriven-guitar|FreePats|electric-guitars|CC0 1.0|FreePats (Electric Guitar FSBS, dist2)|freepats/electric-guitar-FSBS-dist2|HEAD|EGuitarFSBS-dist2 bridge 20220911.sfz|Overdriven Guitar|
distorted-guitar|FreePats|electric-guitars|CC0 1.0|FreePats (Electric Guitar FSBS, dist1)|freepats/electric-guitar-FSBS-dist1|HEAD|EGuitarFSBS-dist1 bridge 20220911.sfz|Distorted Guitar|
nylon-guitar|FreePats|acoustic-guitars|CC0 1.0|FreePats project (Spanish classical guitar)|freepats/spanish-classical-guitar|HEAD|SpanishClassicalGuitar-20190618.sfz|Nylon Guitar|
ukulele|FreePats|acoustic-guitars|CC0 1.0|Mateusz Dąbrowski, for FreePats (Ukulele)|freepats/ukulele1|HEAD|Ukulele 20260811.sfz|Ukulele|
bass|FreePats|basses|CC0 1.0|Andrea Biasior, for FreePats (Finger Bass YR)|freepats/electric-bass-YR|HEAD|FingerBassYR 20190930.sfz|Finger Bass|
drums|FreePats|drums|CC BY 4.0|Lars Muldjord (MuldjordKit, DrumGizmo), FreePats version|freepats/muldjordkit|HEAD|MuldjordKit 20201018.sfz|Drum Kit|Drum samples provided by DrumGizmo.org
